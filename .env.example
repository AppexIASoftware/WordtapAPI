# Servidor HTTP y Red
HOST=0.0.0.0
PORT=8080

# Orígenes CORS permitidos (separados por coma para entornos de desarrollo y producción)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://studio.wordtap.app

# Base de datos MySQL
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordtap_db
# Opcional: DATABASE_URL=root:@tcp(127.0.0.1:3306)/wordtap_db?charset=utf8mb4&parseTime=True&loc=Local

# Migraciones y Seeding
AUTO_MIGRATE=false
AUTO_SEED=false
INITIAL_ADMIN_EMAIL=admin@wordtap.app

# Autenticación JWT
JWT_SECRET=your-32-character-secret-key-goes-here

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
